{
  "manifest_version": 3,
  "name": "Thunderbird AI Test",
  "version": "1.0.0",
  "description": "Simple test add-on for Thunderbird AI Assistant",
  "author": "Test",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-ai-test@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_title": "AI Test",
    "default_popup": "test.html"
  },
  "compose_action": {
    "default_title": "AI Test", 
    "default_popup": "test.html"
  },
  "action": {
    "default_title": "AI Test",
    "default_popup": "test.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["test.html"],
      "matches": ["<all_urls>"]
    }
  ]
} 