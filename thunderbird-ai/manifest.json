{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.3.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Sokrates1989",
  "homepage_url": "https://github.com/Sokrates1989/thunderbird-ai",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-ai@felicitas-wisdom.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesDelete",
    "compose",
    "accountsRead",
    "notifications",
    "storage",
    "menus",
    "tabs",
    "clipboardWrite",
    "sensitiveDataUpload"
  ],
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "64": "icon.svg"
  },
  "background": {
    "scripts": ["locale-de.js", "locale-en.js", "constants.js", "RuntimeDiagnosticService.js", "retry.js", "LaunchModeService.js", "SingleMailWorkspaceService.js", "DashboardLaunchService.js", "storage.js", "message.js", "spam-precheck.js", "dashboard-training.js", "dashboard-mailbox.js", "ai-provider.js", "openai.js", "ui.js", "background.js"]
  },
  "message_display_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icon.svg"
  },
  "action": {
    "default_title": "__MSG_dashboardActionTitle__",
    "default_icon": "icon.svg"
  },

  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },

  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["single-mail-ui.html", "settings.html", "help.html", "icon.svg", "install-defaults.json", "locale-de.js", "locale-en.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
