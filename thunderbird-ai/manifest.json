{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Sokrates1989",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-ai@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesDelete",
    "compose",
    "accountsRead",
    "notifications",
    "storage",
    "menus",
    "tabs",
    "clipboardWrite"
  ],
  "icons": {
    "48": "icon.svg"
  },
  "background": {
    "scripts": ["locale-de.js", "locale-en.js", "constants.js", "storage.js", "message.js", "dashboard-training.js", "openai.js", "ui.js", "background.js"]
  },
  "message_display_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icon.svg",
    "default_popup": "single-mail-ui.html"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": "icon.svg",
    "default_popup": "global-dashboard.html"
  },

  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },

  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["single-mail-ui.html", "settings.html", "help.html", "icon.svg", "install-defaults.json", "locale-de.js", "locale-en.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
